---
import '../styles/global.css';
import { localeDirection, type Locale } from '../i18n/config';
import { site } from '../config/site';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import MogulsConcierge from '../components/global/MogulsConcierge';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const {
  title = site.tagline,
  description = 'Websites, applications, AI solutions, and brand experiences for ambitious businesses in Dubai.',
  locale = 'en',
  canonicalPath,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(
  canonicalPath ?? Astro.url.pathname,
  Astro.site ?? site.url
);
const fullTitle = title.includes(site.name)
  ? title
  : `${title} | ${site.name}`;
---

<!doctype html>
<html lang={locale} dir={localeDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta name="theme-color" content="#141418" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to main content</a>
    <SiteHeader locale={locale} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <MogulsConcierge client:load />
  </body>
</html>

<style>
  .skip-to-content {
    position: fixed;
    top: -120px;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-violet);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: top 160ms ease;
  }
  .skip-to-content:focus {
    top: 1rem;
  }
</style>
