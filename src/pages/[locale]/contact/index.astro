---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { site } from '../../../config/site';
import ContactPageForm from '../../../components/contact/ContactPageForm';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
---

<BaseLayout
  title={`Contact & Commission Brief | ${site.publicBrand}`}
  description="Connect directly with our partners in Dubai to discuss digital platforms, AI automation, growth funnels, brand identity, or strategic roadmaps."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        {/* Left Column: Direct Inquiries & Agency Profile */}
        <div class="lg:col-span-5 flex flex-col gap-8">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-2 h-2 rounded-full bg-[#7456F2] shadow-[0_0_8px_#7456F2]"></span>
              <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold">
                Direct Inquiries · Dubai, UAE
              </span>
            </div>
            <h1 class="text-4xl md:text-5xl font-display font-medium tracking-tight text-[#F7F5F0] mb-4">
              Tell us what you are creating.
            </h1>
            <p class="text-base md:text-lg text-[#8E8D9A] leading-relaxed">
              We architect custom platforms, intelligent systems, and brand foundations for ambitious businesses. Share your scope below or connect directly through our official channels.
            </p>
          </div>

          {/* Verified Contact Channels */}
          <div class="space-y-4 pt-4 border-t border-[#26262F]">
            <div class="p-4 rounded-xl bg-[#1A1A22] border border-[#26262F] flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#22212D] border border-[#3A384A] flex items-center justify-center shrink-0 text-[#7456F2]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-xs text-[#8E8D9A] uppercase tracking-wider font-semibold">Direct Email</span>
                <a href={`mailto:${site.email}`} class="text-[#F7F5F0] hover:text-[#7456F2] font-medium transition-colors text-sm md:text-base">
                  {site.email}
                </a>
                <span class="text-xs text-[#666671] mt-0.5">Formal RFPs, statements of work, and partner briefs</span>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#1A1A22] border border-[#26262F] flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#22212D] border border-[#3A384A] flex items-center justify-center shrink-0 text-[#7456F2]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-xs text-[#8E8D9A] uppercase tracking-wider font-semibold">Telephone & Voice</span>
                <a href={`tel:${site.phone}`} class="text-[#F7F5F0] hover:text-[#7456F2] font-medium transition-colors text-sm md:text-base">
                  {site.phoneDisplay}
                </a>
                <span class="text-xs text-[#666671] mt-0.5">Gulf Standard Time (GST, UTC+4) · Mon – Fri</span>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#1A1A22] border border-[#26262F] flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#22212D] border border-[#3A384A] flex items-center justify-center shrink-0 text-[#7456F2]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-xs text-[#8E8D9A] uppercase tracking-wider font-semibold">Instant Messaging</span>
                <a
                  href={site.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#7456F2] hover:text-[#9A82FC] font-medium transition-colors text-sm md:text-base"
                >
                  Continue on WhatsApp →
                </a>
                <span class="text-xs text-[#666671] mt-0.5">Direct partner messaging for rapid alignment</span>
              </div>
            </div>
          </div>

          {/* Operating Commitments */}
          <div class="p-5 rounded-xl bg-[#141418] border border-[#26262F] space-y-2.5">
            <h4 class="text-xs uppercase tracking-wider text-[#EAE4FF] font-semibold">
              Engagement Governance
            </h4>
            <ul class="text-xs text-[#8E8D9A] space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-[#7456F2] font-bold">✓</span>
                <span>Response within 24 business hours from a practice lead.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#7456F2] font-bold">✓</span>
                <span>Mutual Non-Disclosure Agreement (NDA) executed before deep discovery.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#7456F2] font-bold">✓</span>
                <span>Transparent scoping with phased commercial milestones.</span>
              </li>
            </ul>
          </div>
        </div>

        {/* Right Column: Complete Interactive Project Brief Form */}
        <div class="lg:col-span-7">
          <ContactPageForm client:load />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
