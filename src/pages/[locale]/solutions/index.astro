---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { solutions } from '../../../data/solutions';
import { site } from '../../../config/site';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.props;
---

<BaseLayout
  title={`Commercial Solutions & Architecture Packages | ${site.publicBrand}`}
  description="Explore purpose-built turnkey solutions across AI concierges, revenue operations, automated onboarding, and multi-channel acquisition."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      <div class="max-w-3xl mb-16">
        <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold mb-2 block">
          Integrated Commercial Blueprints · Dubai, UAE
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-[#F7F5F0] mb-4">
          Solutions.
        </h1>
        <p class="text-lg text-[#8E8D9A] leading-relaxed">
          Pre-architected, modular systems combining digital interfaces, AI automation, and performance marketing to solve specific commercial challenges for growing enterprises.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {solutions.map((item, idx) => (
          <a
            href={`/${locale}/solutions/${item.slug}/`}
            class="p-8 rounded-2xl bg-[#181820] border border-[#26262F] hover:border-[#7456F2]/50 hover:bg-[#1C1C26] transition-all group flex flex-col justify-between"
          >
            <div>
              <span class="text-xs font-mono text-[#7456F2] block mb-3 font-semibold">
                SYSTEM {String(idx + 1).padStart(2, '0')}
              </span>
              <h2 class="text-xl font-display font-medium text-[#F7F5F0] group-hover:text-[#FFFFFF] mb-3">
                {item.title}
              </h2>
              <p class="text-xs text-[#8E8D9A] leading-relaxed">
                Full-stack solution combining user interfaces, workflow automation, and telemetry monitoring for {item.title.toLowerCase()}.
              </p>
            </div>
            <span class="text-xs font-semibold text-[#7456F2] group-hover:text-[#9A82FC] mt-6 inline-flex items-center gap-1">
              Explore Architecture Blueprint →
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
