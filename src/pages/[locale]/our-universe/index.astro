---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { site } from '../../../config/site';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.props;

const worlds = [
  {
    slug: 'digital',
    name: 'Moguls Digital',
    tagline: 'High-performance web architecture, responsive apps, and design tokens.',
    accent: '#7456F2',
    services: '14 Specialized Services',
    href: `/${locale}/services/digital/`
  },
  {
    slug: 'ai',
    name: 'Moguls AI',
    tagline: 'Scoped intelligence, retrieval-augmented assistants, and human-in-the-loop workflows.',
    accent: '#9A82FC',
    services: '14 Specialized Services',
    href: `/${locale}/services/ai/`
  },
  {
    slug: 'growth',
    name: 'Moguls Growth',
    tagline: 'High-intent search authority, dedicated landing funnels, and revenue telemetry.',
    accent: '#7456F2',
    services: '14 Specialized Services',
    href: `/${locale}/services/growth/`
  },
  {
    slug: 'creative',
    name: 'Moguls Creative',
    tagline: 'Definitive visual identities, typographic scales, motion graphics, and content suites.',
    accent: '#B99A62',
    services: '14 Specialized Services',
    href: `/${locale}/services/creative/`
  },
  {
    slug: 'strategy',
    name: 'Moguls Strategy',
    tagline: 'Root-cause business diagnosis, market positioning, and phased 30-60-90 day roadmaps.',
    accent: '#7456F2',
    services: '14 Specialized Services',
    href: `/${locale}/services/strategy/`
  }
];
---

<BaseLayout
  title={`The Moguls Universe | ${site.publicBrand}`}
  description="Explore the five interconnected divisions powering Mansas Moguls: Digital, AI, Growth, Creative, and Strategy."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      <div class="max-w-3xl mb-16">
        <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold mb-2 block">
          Integrated Ecosystem · Dubai, UAE
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-[#F7F5F0] mb-4">
          The Moguls Universe.
        </h1>
        <p class="text-lg text-[#8E8D9A] leading-relaxed">
          Five specialized practices operating as one synchronized ecosystem. We connect strategic clarity with beautiful interfaces, intelligent automation, and measurable revenue growth.
        </p>
      </div>

      <div class="space-y-6 max-w-4xl mb-20">
        {worlds.map((world, idx) => (
          <a
            href={world.href}
            class="p-8 rounded-2xl bg-[#181820] border border-[#26262F] hover:border-[#7456F2]/50 hover:bg-[#1C1C26] transition-all group flex flex-col md:flex-row md:items-center justify-between gap-6"
          >
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-mono text-[#7456F2] font-bold">WORLD 0{idx + 1}</span>
                <span class="text-xs text-[#8E8D9A]">· {world.services}</span>
              </div>
              <h2 class="text-2xl font-display font-medium text-[#F7F5F0] group-hover:text-[#FFFFFF] mb-1.5">
                {world.name}
              </h2>
              <p class="text-sm text-[#8E8D9A] max-w-xl">
                {world.tagline}
              </p>
            </div>
            <span class="text-xs font-semibold text-[#7456F2] group-hover:text-[#9A82FC] shrink-0 inline-flex items-center gap-1">
              Explore Practice →
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
