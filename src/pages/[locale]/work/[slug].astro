---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { caseStudies } from '../../../data/case-studies';
import { enabledLocales } from '../../../i18n/config';
export function getStaticPaths(){return enabledLocales.flatMap(locale=>caseStudies.filter(c=>c.approved).map(item=>({params:{locale,slug:item.slug},props:{item}})));}
const {item} = Astro.props;
---
<BaseLayout title={item.title}><section class="page-wrap intro-hero"><h1>{item.title}</h1><p>{item.summary}</p></section></BaseLayout>
