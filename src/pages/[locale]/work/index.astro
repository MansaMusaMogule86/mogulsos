---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { caseStudies } from '../../../data/case-studies';
import PortfolioShowcase from '../../../components/work/PortfolioShowcase';
import { siteConfig } from '../../../config/site';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  title={`Selected Work | ${siteConfig.brand.name}`}
  description="Explore selected client engagements and technical deliveries by Mansas Moguls across digital platforms, AI integrations, creative systems, and strategic roadmaps."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      {/* Header */}
      <div class="max-w-3xl mb-16">
        <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold mb-3 block">
          Client Engagements & Case Studies
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight mb-6">
          Selected Work.
        </h1>
        <p class="text-lg md:text-xl text-[#8E8D9A] leading-relaxed">
          We architect and build bespoke platforms, intelligent systems, and brand foundations for high-growth businesses. Every case study published reflects genuine delivery with explicit client clearance.
        </p>
      </div>

      {/* Portfolio Component */}
      <div class="mb-20">
        <PortfolioShowcase
          client:load
          projects={caseStudies}
          locale={locale ?? 'en'}
        />
      </div>

      {/* Commission Framework */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 border-t border-[#26262F]">
        <div>
          <span class="text-xs font-mono text-[#7456F2] mb-2 block">01 / DISCRETION</span>
          <h3 class="text-lg font-display font-medium text-[#F7F5F0] mb-2">Non-Disclosure Standards</h3>
          <p class="text-sm text-[#8E8D9A] leading-relaxed">
            Many enterprise AI workflows and strategic repositioning engagements are bound by strict mutual NDAs. We respect our clients' competitive advantages.
          </p>
        </div>
        <div>
          <span class="text-xs font-mono text-[#7456F2] mb-2 block">02 / DEMONSTRATION</span>
          <h3 class="text-lg font-display font-medium text-[#F7F5F0] mb-2">Private Walkthroughs</h3>
          <p class="text-sm text-[#8E8D9A] leading-relaxed">
            During private consultations, we can demonstrate relevant architecture models, technical wireframes, and performance telemetry under NDA.
          </p>
        </div>
        <div>
          <span class="text-xs font-mono text-[#7456F2] mb-2 block">03 / INITIATION</span>
          <h3 class="text-lg font-display font-medium text-[#F7F5F0] mb-2">Commissioning Work</h3>
          <p class="text-sm text-[#8E8D9A] leading-relaxed">
            Have a project brief ready? Connect directly with our partners in Dubai to discuss scope, timeline, and architectural direction.
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
