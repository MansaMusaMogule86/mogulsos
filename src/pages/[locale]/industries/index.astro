---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { industries } from '../../../data/industries';
import { site } from '../../../config/site';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
---

<BaseLayout
  title={`Industries & Sector Expertise | ${site.publicBrand}`}
  description="Explore purpose-built digital architectures, AI systems, and brand strategies designed for key economic sectors in Dubai and the GCC."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      <div class="max-w-3xl mb-16">
        <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold mb-2 block">
          Sector Practice Areas · Dubai & GCC
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-[#F7F5F0] mb-4">
          Industry Architecture.
        </h1>
        <p class="text-lg text-[#8E8D9A] leading-relaxed">
          Every industry has distinct regulatory requirements, buyer behaviors, and technological demands. We engineer tailored platforms, automation workflows, and brand positioning tailored to your commercial environment.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map((item, idx) => (
          <a
            href={`/${locale}/industries/${item.slug}/`}
            class="p-8 rounded-2xl bg-[#181820] border border-[#26262F] hover:border-[#7456F2]/50 hover:bg-[#1C1C26] transition-all group flex flex-col justify-between"
          >
            <div>
              <span class="text-xs font-mono text-[#7456F2] block mb-3 font-semibold">
                SECTOR {String(idx + 1).padStart(2, '0')}
              </span>
              <h2 class="text-xl font-display font-medium text-[#F7F5F0] group-hover:text-[#FFFFFF] mb-3">
                {item.title}
              </h2>
              <p class="text-xs text-[#8E8D9A] leading-relaxed">
                Specialized digital surfaces, customer inquiry pipelines, and AI workflows tailored to {item.title.toLowerCase()} operators in Dubai.
              </p>
            </div>
            <span class="text-xs font-semibold text-[#7456F2] group-hover:text-[#9A82FC] mt-6 inline-flex items-center gap-1">
              View Sector Architecture →
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
