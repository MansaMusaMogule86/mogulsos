---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { site } from '../../../config/site';

export function getStaticPaths() {
  return enabledLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.props;

const leadershipPrinciples = [
  {
    role: 'Operating Intelligence',
    title: 'Senior Systems Leadership',
    desc: 'We replace layered agency management tiers with seasoned practitioners who work directly on architectural blueprints, strategic positioning, and engineering delivery.'
  },
  {
    role: 'Cross-Functional Mastery',
    title: 'The T-Shaped Collective',
    desc: 'Every practice director commands deep technical expertise in their primary discipline while maintaining fluency across the other four divisions, guaranteeing seamless cross-practice execution.'
  },
  {
    role: 'Client Stewardship',
    title: 'Committed Commercial Partners',
    desc: 'We view ourselves as long-term stewards of our clients’ market presence, evaluating decisions against multi-year enterprise value rather than short-term agency billable hours.'
  }
];
---

<BaseLayout
  title={`The Moguls | ${site.publicBrand}`}
  description="Meet the creative, strategic, and operating intelligence driving Mansas Moguls in Dubai."
>
  <main class="min-h-screen bg-[#141418] text-[#F7F5F0] pt-32 pb-24">
    <div class="content-container">
      <div class="max-w-3xl mb-16">
        <span class="text-xs uppercase tracking-widest text-[#7456F2] font-semibold mb-2 block">
          Operating Intelligence · Dubai, UAE
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-[#F7F5F0] mb-4">
          The Moguls.
        </h1>
        <p class="text-lg text-[#8E8D9A] leading-relaxed">
          The minds, architects, and practitioners behind Mansas Moguls. We bring together senior engineering, AI orchestration, brand craft, and commercial strategy under one unified roof.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        {leadershipPrinciples.map((item) => (
          <div class="p-8 rounded-2xl bg-[#181820] border border-[#26262F]">
            <span class="text-xs font-mono text-[#7456F2] block mb-3 font-semibold uppercase">{item.role}</span>
            <h2 class="text-xl font-display font-medium text-[#F7F5F0] mb-3">{item.title}</h2>
            <p class="text-sm text-[#8E8D9A] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="p-8 md:p-12 rounded-3xl bg-gradient-to-r from-[#181820] to-[#1E1D2A] border border-[#7456F2]/30 flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="text-2xl font-display font-medium text-[#F7F5F0] mb-2">Connect with our leadership team.</h3>
          <p class="text-sm text-[#8E8D9A] max-w-xl">
            We welcome direct conversations with founders, executives, and marketing directors planning strategic digital initiatives.
          </p>
        </div>
        <a href={`/${locale}/contact/#project-brief`} class="btn btn-primary shrink-0 text-xs px-6 py-3.5">
          Schedule Leadership Consultation →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
