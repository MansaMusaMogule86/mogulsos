---
import HeroSculptureInteractive from "./HeroSculptureInteractive";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
---

<section class="hero-section" aria-labelledby="home-heading">
  {/* Full-width immersive scene background */}
  <div class="hero-scene-layer">
    <HeroSculptureInteractive client:load locale={locale} />
  </div>

  {/* Content overlay: positioned absolutely within the hero */}
  <div class="hero-content-overlay">
    <div class="hero-content-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow-row">
          <span class="eyebrow-pill">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Dubai, United Arab Emirates
          </span>
        </div>

        <h1 id="home-heading" class="hero-headline">
          We Architect<br />What's Next.
        </h1>

        <p class="hero-supporting">
          Websites, applications, AI solutions, and brand experiences for ambitious businesses in Dubai.
        </p>

        <div class="hero-actions">
          <a href={`/${locale}/services/`} class="btn btn-primary">
            Explore Our Services
          </a>
          <a href={`/${locale}/contact/#project-brief`} class="btn btn-secondary-dark">
            Start a Project
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-width immersive hero parent */
  .hero-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 100svh;
    background-color: var(--color-ink, #141418);
    color: var(--color-ivory, #F7F5F0);
    border-bottom: 1px solid rgba(247, 245, 240, 0.08);
    overflow: hidden;
  }

  /* Scene layer: fills entire hero, no visible boundaries */
  .hero-scene-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Content overlay: positioned on top of scene */
  .hero-content-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 10;
    pointer-events: none;
  }

  .hero-content-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    padding-inline: clamp(24px, 5vw, 80px);
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    box-sizing: border-box;
    pointer-events: auto;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 52ch;
  }

  .hero-eyebrow-row {
    display: flex;
    align-items: center;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-lavender, #EAE4FF);
    font-weight: 600;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: var(--color-violet, #7456F2);
    box-shadow: 0 0 8px rgba(116, 86, 242, 0.8);
  }

  .hero-headline {
    font-family: var(--font-display, "Cinzel", "Playfair Display", Georgia, serif);
    font-size: clamp(2.75rem, 5.8vw, 4.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ivory, #F7F5F0);
    margin: 0;
  }

  .hero-supporting {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: #8E8D9A;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* Mobile: flexible content flow */
  @media (max-width: 640px) {
    .hero-section {
      min-height: auto;
    }

    .hero-content-overlay {
      position: relative;
      height: auto;
    }

    .hero-scene-layer {
      position: relative;
      width: 100%;
      height: clamp(300px, 60vw, 500px);
      margin-bottom: -4px;
    }

    .hero-content {
      padding-block: 2rem 1.5rem;
    }
  }
</style>
